generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  TECHNICIAN
  CUSTOMER
  ADMINISTRADOR
  OPERADOR
  COMERCIAL
  TECNICO
  POS_VENDA
  INVESTIDOR
  CONSUMIDOR
}

enum PlantStatus {
  ACTIVE
  INACTIVE
  WARNING
  OFFLINE
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(OPERATOR)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  memberships  UserMembership[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum EquipmentType {
  INVERSOR
  DATALOGGER
  GATEWAY
  MEDIDOR
  COMUNICACAO
  OUTRO
}

model Customer {
  id          String       @id @default(cuid())
  name        String
  document    String?      @unique
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  status      RecordStatus @default(ACTIVE)
  /// Cadastro energético opcional. Nulo em clientes já existentes.
  consumerId  String?      @unique
  consumer    Consumer?    @relation(fields: [consumerId], references: [id], onDelete: SetNull)
  users       User[]
  plants      Plant[]
  memberships UserMembership[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
}

model UserMembership {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       UserRole
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plantId    String?
  plant      Plant?       @relation(fields: [plantId], references: [id], onDelete: Cascade)
  /// Chave estável do contexto (evita duplicata com NULLs no unique composto).
  /// Formato: c:{customerId|-}|p:{plantId|-}
  scopeKey   String
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([userId, role, scopeKey])
  @@index([userId, status])
  @@index([customerId])
  @@index([plantId])
  @@index([role, status])
}

model Plant {
  id              String       @id @default(cuid())
  name            String
  customerId      String
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status          PlantStatus  @default(ACTIVE)
  installedPowerKw Decimal?
  /// Campos legados (texto). Preservados durante a transição para ConsumerUnit.
  distributor     String?
  consumerUnit    String?
  /// Vínculo formal opcional com a Unidade Consumidora do domínio energético.
  consumerUnitId  String?
  consumerUnitRef ConsumerUnit? @relation(fields: [consumerUnitId], references: [id], onDelete: SetNull)
  address         String?
  latitude        Decimal?
  longitude       Decimal?
  inverters       Inverter[]
  equipment       Equipment[]
  readings        MonitoringReading[]
  alerts          Alert[]
  memberships     UserMembership[]
  rateioVersions  EnergyRateioVersion[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([consumerUnitId])
}

model Inverter {
  id             String               @id @default(cuid())
  plantId        String
  plant          Plant                @relation(fields: [plantId], references: [id], onDelete: Cascade)
  manufacturerId String?
  manufacturerRef InverterManufacturer? @relation(fields: [manufacturerId], references: [id])
  /// Código legado do fabricante (texto). Preferir manufacturerId/catálogo.
  manufacturer   String
  model          String?
  /// Serial físico do inversor (≠ serial de gateway/datalogger).
  serialNumber   String?
  ratedPowerKw   Decimal?
  /// Campo legado/opcional. Identidade oficial de integração fica em IntegrationBinding.externalId.
  externalId     String?
  status         String?              @default("ACTIVE")
  readings       MonitoringReading[]
  equipment      Equipment[]
  bindings       IntegrationBinding[]
  alerts         Alert[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([plantId, serialNumber])
  @@index([plantId])
  @@index([manufacturerId])
  @@index([serialNumber])
  @@index([status])
}

model MonitoringReading {
  id             String    @id @default(cuid())
  plantId        String
  plant          Plant     @relation(fields: [plantId], references: [id], onDelete: Cascade)
  inverterId     String?
  inverter       Inverter? @relation(fields: [inverterId], references: [id], onDelete: Cascade)
  collectedAt    DateTime
  powerKw        Decimal?
  energyTodayKwh Decimal?
  energyMonthKwh Decimal?
  energyTotalKwh Decimal?
  communicationOk Boolean  @default(true)
  sourceProvider String?
  idempotencyKey String?   @unique
  rawPayload     Json?
  createdAt      DateTime @default(now())

  @@index([plantId, collectedAt])
  @@index([inverterId, collectedAt])
  @@index([inverterId, sourceProvider, collectedAt])
}

enum AlertResolutionType {
  MANUAL
  AUTOMATIC
}

model Alert {
  id               String               @id @default(cuid())
  plantId          String
  plant            Plant                @relation(fields: [plantId], references: [id], onDelete: Cascade)
  inverterId       String?
  inverter         Inverter?            @relation(fields: [inverterId], references: [id], onDelete: SetNull)
  severity         AlertSeverity
  status           AlertStatus          @default(OPEN)
  type             String
  ruleCode         String
  fingerprint      String
  title            String
  description      String?
  occurredAt       DateTime             @default(now())
  acknowledgedAt   DateTime?
  acknowledgedBy   String?
  resolvedAt       DateTime?
  resolvedBy       String?
  resolutionType   AlertResolutionType?
  events           AlertEvent[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([plantId, status])
  @@index([inverterId, status])
  @@index([fingerprint, status])
  @@index([ruleCode, status])
}

model AlertEvent {
  id        String   @id @default(cuid())
  alertId   String
  alert     Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  type      String
  actor     String
  createdAt DateTime @default(now())

  @@index([alertId, createdAt])
}

enum ManufacturerIntegrationStatus {
  PLANNED
  READY
  ACTIVE
}

enum InverterOperationalStatus {
  ONLINE
  OFFLINE
  WARNING
  ERROR
  UNKNOWN
}

model InverterManufacturer {
  id                String                         @id @default(cuid())
  code              String                         @unique
  name              String
  active            Boolean                        @default(true)
  integrationStatus ManufacturerIntegrationStatus  @default(PLANNED)
  capabilities      Json?
  inverters         Inverter[]
  bindings          IntegrationBinding[]
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
}

model Equipment {
  id               String        @id @default(cuid())
  plantId          String
  plant            Plant         @relation(fields: [plantId], references: [id], onDelete: Cascade)
  /// Vínculo opcional ao inversor (ex.: GATEWAY/DATALOGGER auxiliar). Não transforma gateway em inversor.
  inverterId       String?
  inverter         Inverter?     @relation(fields: [inverterId], references: [id], onDelete: SetNull)
  type             EquipmentType
  manufacturerName String?
  model            String?
  /// Serial físico do equipamento (≠ serial do inversor).
  serialNumber     String
  status           RecordStatus  @default(ACTIVE)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([plantId, serialNumber])
  @@index([plantId])
  @@index([type])
  @@index([status])
  @@index([inverterId])
}

enum IntegrationBindingStatus {
  NOT_CONFIGURED
  READY
  CONNECTED
  AUTH_ERROR
  COMMUNICATION_ERROR
}

model Integration {
  id          String   @id @default(cuid())
  name        String
  provider    String
  enabled     Boolean  @default(true)
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IntegrationBinding {
  id               String                    @id @default(cuid())
  provider         String
  manufacturerId   String?
  manufacturer     InverterManufacturer?     @relation(fields: [manufacturerId], references: [id])
  /// Entidade principal monitorada (Inverter). Gateway/Datalogger permanece em Equipment.
  inverterId       String
  inverter         Inverter                  @relation(fields: [inverterId], references: [id], onDelete: Cascade)
  /// Identidade externa principal do recurso no fabricante (genérica; não é serial físico).
  externalId       String?
  /// Metadados externos genéricos do adapter (ex.: plantId/deviceId/gatewayId do fabricante).
  /// Sem campos específicos por fabricante no domínio central.
  externalMeta     Json?
  status           IntegrationBindingStatus  @default(NOT_CONFIGURED)
  /// Referência a segredo externo — nunca o valor do secret/token.
  secretRef        String?
  lastSyncAt       DateTime?
  lastErrorAt      DateTime?
  lastErrorMessage String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@unique([inverterId, provider])
  @@index([provider])
  @@index([externalId])
}

/// Cadastro energético mínimo (Domínio 4.1). Sem vínculo com Plant/Rateio/Billing.
enum DocumentType {
  CPF
  CNPJ
}

model Distributor {
  id            String         @id @default(cuid())
  name          String
  code          String         @unique
  cnpj          String?
  status        RecordStatus   @default(ACTIVE)
  consumerUnits ConsumerUnit[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([name])
}

model Consumer {
  id            String         @id @default(cuid())
  name          String
  document      String         @unique
  documentType  DocumentType
  email         String?
  phone         String?
  status        RecordStatus   @default(ACTIVE)
  consumerUnits ConsumerUnit[]
  rateioLines   EnergyRateioLine[]
  customer      Customer?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([name])
}

/// Unidade Consumidora (UC). Independente de Plant; Rateio versionado mediado por EnergyRateio*.
model ConsumerUnit {
  id              String       @id @default(cuid())
  consumerId      String
  consumer        Consumer     @relation(fields: [consumerId], references: [id])
  distributorId   String
  distributor     Distributor  @relation(fields: [distributorId], references: [id])
  /// Número/código da UC no contexto da distribuidora (≠ Conta Contrato).
  number          String
  /// Conta Contrato — distinta do número da UC; opcional quando ainda não confirmada.
  contractAccount String?
  address         String?
  status          RecordStatus @default(ACTIVE)
  plants          Plant[]
  rateioLines     EnergyRateioLine[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([distributorId, number])
  @@index([consumerId])
  @@index([distributorId])
  @@index([status])
}

/// Status persistido da versão de Rateio. EXPIRED é derivado da vigência na leitura.
enum EnergyRateioVersionStatus {
  ACTIVE
  CANCELLED
}

/// Versão de composição de Rateio de uma Plant (UI: Rateio). Σ percentage das linhas = 100%.
/// Rateio representa regra de distribuição — não energia compensada, crédito ou saldo.
model EnergyRateioVersion {
  id            String                    @id @default(cuid())
  plantId       String
  plant         Plant                     @relation(fields: [plantId], references: [id], onDelete: Restrict)
  versionNumber Int
  validFrom     DateTime
  /// Fim exclusivo [validFrom, validTo). NULL = vigência aberta.
  validTo       DateTime?
  status        EnergyRateioVersionStatus @default(ACTIVE)
  /// Modalidade SCEE/regulatória — nullable até enumeração oficial.
  modality      String?
  reason        String?
  createdBy     String?
  lines         EnergyRateioLine[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@unique([plantId, versionNumber])
  @@index([plantId, status])
  @@index([plantId, validFrom])
  @@index([validFrom, validTo])
}

/// Linha de Rateio: UC + Consumidor + percentual dentro de uma versão.
model EnergyRateioLine {
  id               String             @id @default(cuid())
  rateioVersionId  String
  rateioVersion    EnergyRateioVersion @relation(fields: [rateioVersionId], references: [id], onDelete: Cascade)
  consumerUnitId   String
  consumerUnit     ConsumerUnit       @relation(fields: [consumerUnitId], references: [id], onDelete: Restrict)
  /// Deve coincidir com ConsumerUnit.consumerId (validado no serviço).
  consumerId       String
  consumer         Consumer           @relation(fields: [consumerId], references: [id], onDelete: Restrict)
  /// Percentual 0 < p ≤ 100. Decimal(7,4) — não float binário.
  percentage       Decimal            @db.Decimal(7, 4)
  createdAt        DateTime           @default(now())

  @@unique([rateioVersionId, consumerUnitId])
  @@index([consumerUnitId])
  @@index([consumerId])
  @@index([rateioVersionId])
}